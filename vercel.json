{
  "version": 2,
  "buildCommand": "npm run build",
  "installCommand": "npm install",
  "framework": "nextjs",
  "redirects": [
    { "source": "/", "destination": "/axon", "permanent": false }
  ],
  "rewrites": [
    { "source": "/api/conversations/([^/]+)/messages", "destination": "/api/conversations/$1/messages" }
  ]
}
